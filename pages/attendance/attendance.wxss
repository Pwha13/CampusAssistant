/* 考勤管理页面样式 */
.page-attendance {
  background: #f5f7fa;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  padding: 32rpx 24rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stats-num.warning {
  color: #faad14;
}

.stats-num.danger {
  color: #ff7875;
}

.stats-num.info {
  color: #69c0ff;
}

.stats-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 8rpx 0;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 50%;
  margin-right: -36rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 筛选栏 */
.filter-bar {
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.filter-item.active {
  background: #e6f7ff;
  color: #1890ff;
}

/* 考勤记录列表 */
.record-list, .appeal-list {
  padding: 16rpx 24rpx;
}

.record-item, .appeal-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.record-header, .appeal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-student, .appeal-student {
  display: flex;
  align-items: center;
}

.student-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.student-id {
  font-size: 22rpx;
  color: #999;
}

.record-body, .appeal-body {
  padding: 0 8rpx;
}

.record-row, .appeal-row {
  display: flex;
  margin-bottom: 8rpx;
}

.record-label, .appeal-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
}

.record-value, .appeal-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.appeal-value.reason {
  color: #666;
  line-height: 1.6;
}

/* 申诉操作按钮 */
.appeal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.btn-reject, .btn-approve {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}

.btn-reject {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

.btn-approve {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.btn-reject::after, .btn-approve::after {
  border: none;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #e8e8e8;
  border-top: 3rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 22rpx;
  color: #ccc;
}

/* 申诉表单 */
.appeal-form {
  padding: 16rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

/* 底部占位 */
.tab-bar-placeholder {
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
