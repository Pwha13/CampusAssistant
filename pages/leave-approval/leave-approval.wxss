/* 请假审批页面样式 */
.page-leave-approval {
  background: #f5f7fa;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  padding: 32rpx 24rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stats-num.warning {
  color: #faad14;
}

.stats-num.success {
  color: #b7eb8f;
}

.stats-num.danger {
  color: #ff7875;
}

.stats-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 8rpx 0;
}

/* 筛选栏 */
.filter-bar {
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.filter-item.active {
  background: #e6f7ff;
  color: #1890ff;
}

/* 请假列表 */
.leave-list {
  padding: 16rpx 24rpx;
}

.leave-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.leave-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.leave-student {
  display: flex;
  align-items: center;
}

.student-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.student-id {
  font-size: 22rpx;
  color: #999;
}

.leave-body {
  padding: 0 8rpx;
}

.leave-row {
  display: flex;
  margin-bottom: 8rpx;
}

.leave-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
}

.leave-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.leave-value.reason {
  color: #666;
  line-height: 1.6;
}

.leave-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.leave-time {
  font-size: 22rpx;
  color: #999;
  align-self: flex-start;
  margin-bottom: 12rpx;
}

.leave-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.btn-reject, .btn-approve {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}

.btn-reject {
  background: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

.btn-approve {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.btn-reject::after, .btn-approve::after {
  border: none;
}

.reject-reason {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #fff2f0;
  border-radius: 8rpx;
}

.reject-label {
  font-size: 22rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.reject-text {
  font-size: 22rpx;
  color: #ff7875;
}

/* 详情弹窗 */
.detail-content {
  padding: 8rpx 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.detail-value.remark {
  color: #666;
}

/* 审批表单 */
.approval-form {
  padding: 16rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #e8e8e8;
  border-top: 3rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 22rpx;
  color: #ccc;
}

/* 底部占位 */
.tab-bar-placeholder {
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
