/* 校园公告页样式 */
.page-announcements {
  background: #f5f7fa;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

/* 分类筛选 */
.category-scroll {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-list {
  display: flex;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  margin-right: 16rpx;
  transition: all 0.3s;
}

.category-item.active {
  background: #1890ff;
  color: #fff;
}

/* 公告列表 */
.announcement-list {
  padding: 16rpx 24rpx;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 8rpx;
}

.announcement-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.announcement-item.top {
  border-left: 6rpx solid #ff4d4f;
}

.ann-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ann-time {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 12rpx;
}

.ann-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
  /* 两行省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ann-summary {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.ann-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ann-publisher {
  font-size: 22rpx;
  color: #1890ff;
}

.ann-views {
  font-size: 22rpx;
  color: #ccc;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #e8e8e8;
  border-top: 3rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 22rpx;
  color: #ccc;
}

/* 公告详情弹窗 */
.detail-content {
  padding: 8rpx 0;
}

.detail-meta {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-publisher {
  font-size: 24rpx;
  color: #666;
  margin-left: 12rpx;
  margin-right: 20rpx;
}

.detail-time {
  font-size: 22rpx;
  color: #bbb;
}

.detail-body {
  line-height: 1.8;
  font-size: 28rpx;
  color: #333;
}

.detail-para {
  display: block;
  margin-top: 20rpx;
  text-indent: 2em;
  white-space: pre-wrap;
}

.detail-footer {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-views {
  font-size: 22rpx;
  color: #ccc;
}
