/* 请假管理页样式 */
.page-leave {
  background: #f5f7fa;
  min-height: 100vh;
}

/* 统计卡片 */
.leave-stats {
  display: flex;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  padding: 40rpx 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  margin-top: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 8rpx 0;
}

/* 状态标签筛选 */
.status-tabs {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-list {
  display: flex;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.status-tab.active {
  background: #e6f7ff;
  color: #1890ff;
}

/* 请假列表 */
.leave-list {
  padding: 16rpx 24rpx;
}

.leave-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.leave-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.leave-type-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.leave-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-approved {
  background: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background: #fff2f0;
  color: #ff4d4f;
}

.leave-id {
  font-size: 22rpx;
  color: #ccc;
}

.leave-body {
  margin-bottom: 16rpx;
}

.leave-info-row {
  display: flex;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.info-value.reason {
  color: #666;
}

.leave-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.leave-apply-time {
  font-size: 22rpx;
  color: #bbb;
}

.leave-approver {
  font-size: 22rpx;
  color: #999;
}

.leave-reject {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fff2f0;
  border-radius: 8rpx;
}

.reject-label {
  font-size: 22rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.reject-text {
  font-size: 22rpx;
  color: #ff7875;
}

/* 新建请假按钮 */
.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.add-btn-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: 300;
}

.add-btn-text {
  font-size: 28rpx;
}

/* 请假表单 */
.leave-form {
  padding: 8rpx 0 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 4rpx;
}

/* 类型选择 */
.type-options {
  display: flex;
  gap: 16rpx;
}

.type-option {
  padding: 14rpx 32rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.type-option.active {
  background: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

/* 日期选择 */
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.form-picker.placeholder {
  color: #ccc;
}

.picker-arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.textarea-counter {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.textarea-counter .valid {
  color: #52c41a;
}

.form-error {
  font-size: 22rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  display: block;
}

/* 附件上传 */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background: #f5f5f5;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.upload-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.preview-name {
  font-size: 26rpx;
  color: #333;
}

.preview-remove {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  margin-top: 32rpx;
}

.submit-btn::after {
  border: none;
}

/* 详情弹窗 */
.detail-content {
  padding: 8rpx 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.detail-value.remark {
  color: #666;
}

/* 加载 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #e8e8e8;
  border-top: 3rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}
