<!-- 学生端首页 -->
<view class="page-home">
  <!-- 顶部欢迎区域 -->
  <view class="home-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="welcome-row">
        <view class="welcome-text">
          <text class="welcome-hello">你好，{{userInfo.name || '同学'}} 👋</text>
          <text class="welcome-role">{{userInfo.college}} · {{userInfo.className}}</text>
        </view>
        <image class="header-avatar" src="{{userInfo.avatar || '/static/images/avatar-default.png'}}" mode="aspectFill" bindtap="goProfile"></image>
      </view>
      <!-- 今日打卡状态概览 -->
      <view class="checkin-overview">
        <view class="overview-item">
          <text class="overview-dot {{morningChecked ? 'checked' : ''}}"></text>
          <text class="overview-label">查寝</text>
        </view>
        <view class="overview-item">
          <text class="overview-dot {{classChecked ? 'checked' : ''}}"></text>
          <text class="overview-label">上课</text>
        </view>
        <view class="overview-item">
          <text class="overview-dot {{nightChecked ? 'checked' : ''}}"></text>
          <text class="overview-label">晚寝</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 打卡功能区 -->
  <view class="section-checkin">
    <view class="section-title">
      <text class="title-text">快捷打卡</text>
      <text class="title-sub">请在规定时间内完成打卡</text>
    </view>
    <view class="checkin-grid">
      <!-- 【查寝打卡】模拟定位+人脸核验 -->
      <view class="checkin-card {{morningChecked ? 'done' : ''}}" bindtap="onCheckin" data-type="morning">
        <view class="checkin-icon-wrap morning">
          <text class="checkin-icon-text">🌅</text>
        </view>
        <text class="checkin-name">查寝打卡</text>
        <text class="checkin-status">{{morningChecked ? '已完成 ✓' : '待打卡'}}</text>
      </view>

      <!-- 【上课打卡】模拟人脸核验 -->
      <view class="checkin-card {{classChecked ? 'done' : ''}}" bindtap="onCheckin" data-type="class">
        <view class="checkin-icon-wrap class">
          <text class="checkin-icon-text">📚</text>
        </view>
        <text class="checkin-name">上课打卡</text>
        <text class="checkin-status">{{classChecked ? '已完成 ✓' : '待打卡'}}</text>
      </view>

      <!-- 晚寝打卡 -->
      <view class="checkin-card {{nightChecked ? 'done' : ''}}" bindtap="onCheckin" data-type="night">
        <view class="checkin-icon-wrap night">
          <text class="checkin-icon-text">🌙</text>
        </view>
        <text class="checkin-name">晚寝打卡</text>
        <text class="checkin-status">{{nightChecked ? '已完成 ✓' : '待打卡'}}</text>
      </view>
    </view>
  </view>

  <!-- 今日课程 -->
  <view class="section-schedule">
    <view class="section-title">
      <text class="title-text">今日课程</text>
      <text class="title-sub">{{todayCourses.length > 0 ? '共' + todayCourses.length + '节课' : '今天没有课程'}}</text>
    </view>
    <block wx:if="{{todayCourses.length > 0}}">
      <view class="schedule-item" wx:for="{{todayCourses}}" wx:key="id">
        <view class="schedule-time">
          <text class="time-start">{{item.startTime}}</text>
          <text class="time-end">{{item.endTime}}</text>
        </view>
        <view class="schedule-line">
          <view class="line-dot"></view>
          <view class="line-bar"></view>
        </view>
        <view class="schedule-info">
          <text class="schedule-name">{{item.name}}</text>
          <text class="schedule-teacher">{{item.teacher}}</text>
          <text class="schedule-location">📍 {{item.location}}</text>
        </view>
      </view>
    </block>
    <empty-state wx:else text="今天没有课程，好好休息吧~" />
  </view>

  <!-- 最近打卡记录 -->
  <view class="section-record">
    <view class="section-title">
      <text class="title-text">最近打卡</text>
      <text class="title-extra" bindtap="goCheckinHistory">查看全部 ›</text>
    </view>
    <view class="record-list" wx:if="{{recentRecords.length > 0}}">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id">
        <view class="record-left">
          <text class="record-type-icon">{{item.type === 'morning' ? '🌅' : item.type === 'class' ? '📚' : '🌙'}}</text>
        </view>
        <view class="record-center">
          <text class="record-type">{{item.type === 'morning' ? '查寝打卡' : item.type === 'class' ? '上课打卡' : '晚寝打卡'}}</text>
          <text class="record-location">{{item.location}}</text>
        </view>
        <view class="record-right">
          <text class="record-time">{{item.time}}</text>
          <text class="record-status success">✓</text>
        </view>
      </view>
    </view>
    <empty-state wx:else text="暂无打卡记录" />
  </view>

  <!-- 公告快览入口 -->
  <view class="section-notice" bindtap="goAnnouncements">
    <view class="notice-icon">📢</view>
    <view class="notice-content">
      <text class="notice-title">校园公告</text>
      <text class="notice-desc">查看最新校园通知</text>
    </view>
    <text class="notice-arrow">›</text>
  </view>
</view>

<!-- 模拟定位弹窗 -->
<popup-component
  visible="{{locationPopupVisible}}"
  title="📍 模拟定位确认"
  showFooter="{{true}}"
  confirmText="确认打卡"
  cancelText="取消"
  bind:confirm="onLocationConfirm"
  bind:cancel="onLocationCancel"
  bind:close="onLocationCancel"
>
  <view class="popup-location">
    <view class="location-map">
      <text class="location-icon">🗺️</text>
      <text class="location-label">模拟地图区域</text>
    </view>
    <view class="location-info">
      <view class="location-row">
        <text class="location-key">当前位置：</text>
        <text class="location-value">{{currentLocation}}</text>
      </view>
      <view class="location-row">
        <text class="location-key">打卡要求：</text>
        <text class="location-value">{{checkinRequirement}}</text>
      </view>
      <view class="location-status {{locationMatch ? 'match' : ''}}">
        <text>{{locationMatch ? '✓ 位置匹配，可以打卡' : '✕ 位置不在打卡范围内'}}</text>
      </view>
    </view>
  </view>
</popup-component>

<!-- 模拟人脸核验弹窗 -->
<popup-component
  visible="{{facePopupVisible}}"
  title="😊 人脸核验"
  showFooter="{{false}}"
  bind:close="onFaceCancel"
>
  <view class="popup-face">
    <view class="face-camera">
      <view class="face-frame">
        <text class="face-text" wx:if="{{faceStep === 0}}">请将面部对准框内</text>
        <text class="face-text scanning" wx:elif="{{faceStep === 1}}">正在扫描中...</text>
        <text class="face-text success" wx:elif="{{faceStep === 2}}">✓ 核验通过</text>
      </view>
    </view>
    <view class="face-tips">
      <text class="face-tip-item" wx:if="{{faceStep === 0}}">请确保光线充足，正视摄像头</text>
      <text class="face-tip-item" wx:elif="{{faceStep === 1}}">请保持静止，正在进行人脸比对...</text>
      <text class="face-tip-item success" wx:elif="{{faceStep === 2}}">人脸识别成功，即将完成打卡</text>
    </view>
    <button class="face-btn" wx:if="{{faceStep === 0}}" bindtap="onStartFaceScan">开始识别</button>
    <view class="face-loading" wx:elif="{{faceStep === 1}}">
      <view class="face-spinner"></view>
    </view>
  </view>
</popup-component>

<!-- Toast组件 -->
<toast-component visible="{{toastVisible}}" type="{{toastType}}" message="{{toastMessage}}" bind:close="onToastClose" />