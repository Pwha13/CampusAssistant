/* 学生首页样式 */
.page-home {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部欢迎区域 */
.home-header {
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 380rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  padding: 48rpx 32rpx 36rpx;
  z-index: 1;
}

.welcome-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.welcome-text {
  display: flex;
  flex-direction: column;
}

.welcome-hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.welcome-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

/* 打卡状态概览 */
.checkin-overview {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-around;
}

.overview-item {
  display: flex;
  align-items: center;
}

.overview-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin-right: 10rpx;
}

.overview-dot.checked {
  background: #52c41a;
}

.overview-label {
  font-size: 24rpx;
  color: #fff;
}

/* 通用区块标题 */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.title-sub {
  font-size: 22rpx;
  color: #bbb;
}

.title-extra {
  font-size: 24rpx;
  color: #1890ff;
}

/* 打卡功能区 */
.section-checkin {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.checkin-grid {
  display: flex;
  padding: 0 16rpx;
  gap: 16rpx;
}

.checkin-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  transition: all 0.3s;
}

.checkin-card.done {
  background: #f6ffed;
}

.checkin-card:active {
  transform: scale(0.96);
}

.checkin-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.checkin-icon-wrap.morning { background: #fff7e6; }
.checkin-icon-wrap.class { background: #e6f7ff; }
.checkin-icon-wrap.night { background: #f0f5ff; }

.checkin-icon-text { font-size: 44rpx; }

.checkin-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.checkin-status {
  font-size: 22rpx;
  color: #999;
}

.checkin-card.done .checkin-status {
  color: #52c41a;
}

/* 今日课程 */
.section-schedule {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.schedule-item {
  display: flex;
  padding: 20rpx 32rpx;
}

.schedule-time {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.time-start {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.time-end {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.schedule-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 32rpx;
  margin: 0 16rpx;
}

.line-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1890ff;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.line-bar {
  flex: 1;
  width: 2rpx;
  background: #e8e8e8;
}

.schedule-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 4rpx 0;
}

.schedule-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.schedule-teacher {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.schedule-location {
  font-size: 22rpx;
  color: #999;
}

/* 最近打卡记录 */
.section-record {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-list {
  padding: 0 32rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  margin-right: 20rpx;
}

.record-type-icon {
  font-size: 36rpx;
}

.record-center {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-type {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.record-location {
  font-size: 22rpx;
  color: #999;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.record-status.success {
  color: #52c41a;
  font-size: 28rpx;
  font-weight: 600;
}

/* 公告快览入口 */
.section-notice {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.notice-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.notice-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.notice-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.notice-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ====== 弹窗内部样式 ====== */
/* 定位弹窗 */
.popup-location {
  padding: 8rpx 0;
}

.location-map {
  height: 240rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.location-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.location-label {
  font-size: 24rpx;
  color: #1890ff;
}

.location-info {
  padding: 0 8rpx;
}

.location-row {
  display: flex;
  margin-bottom: 12rpx;
}

.location-key {
  font-size: 26rpx;
  color: #999;
  width: 160rpx;
}

.location-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.location-status {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fff2f0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ff4d4f;
}

.location-status.match {
  background: #f6ffed;
  color: #52c41a;
}

/* 人脸核验弹窗 */
.popup-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.face-camera {
  width: 360rpx;
  height: 360rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.face-frame {
  width: 300rpx;
  height: 300rpx;
  border: 4rpx dashed #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.face-text {
  font-size: 26rpx;
  color: #999;
}

.face-text.scanning {
  color: #1890ff;
}

.face-text.success {
  color: #52c41a;
  font-weight: 600;
}

.face-tips {
  text-align: center;
  margin-bottom: 24rpx;
}

.face-tip-item {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.face-tip-item.success {
  color: #52c41a;
}

.face-btn {
  width: 400rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #1890ff;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.face-btn::after {
  border: none;
}

.face-loading {
  padding: 32rpx;
}

.face-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8e8e8;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}