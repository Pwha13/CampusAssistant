/* 登录页样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890ff 0%, #e6f7ff 50%, #f5f5f5 100%);
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
}

/* 顶部Logo */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  margin-bottom: 80rpx;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.3);
}

.logo-icon {
  font-size: 80rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.login-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* 登录表单 */
.login-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
}

/* 角色切换 */
.role-switch {
  display: flex;
  margin-bottom: 48rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.role-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.role-item.active {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.role-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.role-text {
  font-size: 28rpx;
  color: #666;
}

.role-item.active .role-text {
  color: #1890ff;
  font-weight: 600;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: relative;
}

.form-item.focused {
  border-bottom-color: #1890ff;
}

.form-item.error {
  border-bottom-color: #ff4d4f;
}

.form-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  padding: 12rpx 0;
  width: 100%;
}

.form-eye {
  position: absolute;
  right: 0;
  bottom: 16rpx;
  padding: 8rpx;
}

.form-error {
  font-size: 22rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  display: block;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-top: 48rpx;
  border: none;
  letter-spacing: 8rpx;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #b3d8ff;
  color: rgba(255, 255, 255, 0.8);
}

/* 提示 */
.login-tip {
  margin-top: 32rpx;
  text-align: center;
}

.tip-text {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.8;
}

/* 底部版权 */
.login-footer {
  position: fixed;
  bottom: 48rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}
