/**
 * 校园助手小程序 - 全局样式
 * 包含：基础重置、通用类、颜色变量、间距工具类
 */

/* ============ 基础重置 ============ */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f5f7fa;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ============ 通用容器 ============ */
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

/* ============ 安全区域适配 ============ */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ Flex工具类 ============ */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* ============ 文本工具类 ============ */
.text-center {
  text-align: center;
}

.text-primary {
  color: #1890ff;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-danger {
  color: #ff4d4f;
}

.text-gray {
  color: #999;
}

.text-bold {
  font-weight: 600;
}

/* 文本省略（单行） */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 文本省略（两行） */
.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ============ 间距工具类 ============ */
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-16 { margin-right: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* ============ 圆角 ============ */
.rounded {
  border-radius: 16rpx;
}

.rounded-full {
  border-radius: 50%;
}

/* ============ 阴影 ============ */
.shadow {
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.shadow-lg {
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* ============ 分割线 ============ */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}
